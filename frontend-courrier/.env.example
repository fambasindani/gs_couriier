# URL absolue de l'API.
# - En dev local : VITE_API_URL=http://127.0.0.1:8000 (ou vide + proxy)
# - En dev vers API distante : vide + proxy (ci-dessous)
# - En production : si le front n'est PAS servi sur le même domaine, mets l'URL absolue
#   (ex: https://totalconceptrdc.org/sgec-api) au moment de `npm run build`.
VITE_API_URL=

# Cible du proxy Vite en dev (évite le CORS) : ex. https://totalconceptrdc.org/sgec-api
VITE_PROXY_TARGET=

# Mode démo sans API (true) / API réelle (false)
VITE_USE_MOCK=false